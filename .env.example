# Placeholders for environment variables and secrets.
# Do NOT place sensitive production credentials in this example file.
# Configure your active keys via the Secrets panel in AI Studio or in your local .env file.

# Gemini API Keys
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_BACKUP_API_KEY=YOUR_GEMINI_BACKUP_API_KEY

# RevenueCat Android Public SDK Key (Starts with goog_ for Google Play or test_ for Sandbox)
REVENUECAT_PUBLIC_KEY=goog_YOUR_REVENUECAT_PUBLIC_KEY

# Google Sign-In OAuth 2.0 Web Client ID
WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID
