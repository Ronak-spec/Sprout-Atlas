# Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_BACKUP_API_KEY=

# RevenueCat Public SDK Key (https://app.revenuecat.com/)
REVENUECAT_PUBLIC_KEY=goog_YOUR_REVENUECAT_PUBLIC_KEY

# Google Sign-In OAuth 2.0 Web Client ID (from Google Cloud Console / Firebase Authentication)
WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
